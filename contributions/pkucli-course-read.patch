+
     /// 查看课程侧边栏入口
     Info {
         /// 课程 ID 或编号（从 courses 列表中获取）
@@ -227,6 +239,9 @@ pub async fn dispatch(command: Commands) -> Result<()> {
         Commands::Logout => login::logout()?,
 
         // ── Browse ──
+        Commands::Recordings { date, search } => commands::cmd_recordings(&date, &search).await?,
+        Commands::RecordingSessions { course } => commands::cmd_recording_sessions(&course).await?,
+        Commands::LearningGrades { course } => commands::cmd_learning_grades(&course).await?,
         Commands::Courses { all } => commands::cmd_courses(all).await?,
         Commands::Info { course } => commands::cmd_info(&course).await?,
