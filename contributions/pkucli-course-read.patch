     },
 
+    /// 独立课堂实录目录（JSON；需要教学网回放 SSO）
+    Recordings {
+        #[arg(long)]
+        date: String,
+        #[arg(long, default_value = "")]
+        search: String,
+    },
+    /// 独立课堂实录的全部课次（JSON；使用实录 course_id）
+    RecordingSessions { course: String },
