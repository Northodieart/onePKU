{
  "app": {
    "windows": [
      {
        "title": "OnePKU",
        "width": 1320,
        "height": 880,
        "minWidth": 760,
        "minHeight": 600,
        "zoomHotkeysEnabled": true
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "hooks/uninstall.nsi",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
